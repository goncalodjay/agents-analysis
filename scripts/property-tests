#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
node --experimental-strip-types --test extensions/agents-analysis.property.test.ts
# The whole-suite pass loads the TUI, whose renderer needs node:ffi.
node --experimental-strip-types --experimental-ffi --test --test-name-pattern="^property:"
